migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code isolated worktrees (subagent isolation)
.claude/worktrees/

# Photos uploaded during local play. The backend writes these to uploads/ at
# the repo root; backend/.gitignore only covers backend/uploads/, so without
# this real photos from test games get staged.
/uploads/
node_modules/
apps/website/.next/
apps/website/out/
apps/website/next-env.d.ts
apps/website/tsconfig.tsbuildinfo

# Desktop platforms are not targeted (iOS/Android/web only), but `flutter pub get`
# still regenerates plugin registrants into linux/ and macos/. The real platform
# projects were deleted; this keeps the regenerated scaffolding out of the tree.
/linux/
/macos/
/windows/
