<?xml version="1.0" encoding="utf-8"?>
<!-- Generated companion to the iOS launch storyboard: the same brand ground
     and the same mark, so neither platform flashes white before the app's
     dark UI appears. The mark comes from assets/branding/logo_mark.svg via
     scripts/generate-app-icons.sh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
